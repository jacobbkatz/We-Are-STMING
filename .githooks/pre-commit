#!/usr/bin/env bash
#
# Refuses a commit while check_facts.py is failing.
#
# Why this exists. On 2026-09-09 a session pushed commit 1198651 to main with
# check_facts.py exiting 1 on its own repository. The verification had been run
# -- inside an "&&" chain, which reports the success of the last command in it,
# not the one that mattered. The failure went straight past.
#
# The same session had already written the rule "run the check as its own command
# and read the exit code". A rule is not a mechanism. This is the mechanism.
#
# To commit anyway -- mid-fix, or when you know why it is failing:
#     git commit --no-verify
#
# Installed automatically by .claude/session-start.sh via core.hooksPath, so it
# reaches both computers without anyone running anything.

REPO=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
[ -f "$REPO/Code/pc/check_facts.py" ] || exit 0

# Pick a Python that actually runs. Added 2026-09-16 on Jacob's Windows machine,
# where `python3` and `python` are Microsoft Store placeholders: they exist on the
# PATH, print "Python was not found", and exit non-zero. Calling python3 blindly
# would have blocked every commit there with a message about a checker failure
# that never ran. The `py` launcher is what works on that machine.
PY=""
for cand in python3 python py; do
    if command -v "$cand" >/dev/null 2>&1 && "$cand" -c "import sys" >/dev/null 2>&1; then
        PY="$cand"
        break
    fi
done

if [ -z "$PY" ]; then
    echo ""
    echo "COMMIT BLOCKED - no working Python found (tried python3, python, py),"
    echo "so check_facts.py could not run. Install Python, then commit again."
    echo ""
    exit 1
fi

OUT=$(cd "$REPO" && "$PY" Code/pc/check_facts.py 2>&1)
RC=$?

if [ "$RC" -eq 0 ]; then
    exit 0
fi

echo ""
echo "=================================================================="
echo " COMMIT BLOCKED - check_facts.py is failing"
echo "=================================================================="
echo ""
echo "$OUT"
echo ""
echo "Fix what it names above, then commit again."
echo ""
echo "If you know why it is failing and want to commit anyway:"
echo "    git commit --no-verify"
echo ""
exit 1
